    <!-- Onboarding Screen -->
    <string name="onboarding_welcome_title">歡迎使用 Call Blocker</string>
    <string name="onboarding_welcome_desc">您最強大的隱私守衛，抵禦垃圾來電、推銷與不受歡迎的電話。功能強大、完全離線運作且安全無虞。</string>
    <string name="onboarding_privacy_title">隱私權優先聲明</string>
    <string name="onboarding_privacy_desc">我們需要存取您的「通訊錄」與「通話紀錄」以比對來電號碼。<b>所有資料 100% 在您的設備上進行本機處理。</b>我們絕對不會將您的任何資料上傳至任何伺服器。</string>
    <string name="onboarding_btn_next">下一步</string>

