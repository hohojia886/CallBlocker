    <string name="onboarding_btn_grant_permissions">授予權限</string>

    <string name="onboarding_role_title">最後一步：來電篩選角色</string>
    <string name="onboarding_role_desc">為了能在手機響鈴前主動攔截來電，Call Blocker 需要被設定為預設的「來電篩選應用程式」。</string>
