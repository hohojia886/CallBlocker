    <!-- Onboarding Screen -->
    <string name="onboarding_welcome_title">Selamat Datang di CallBlocker</string>
    <string name="onboarding_welcome_desc">Penjaga privasi utama Anda dari spam, telemarketing, dan panggilan yang tidak diinginkan. Kuat, sepenuhnya offline, dan aman.</string>
    <string name="onboarding_privacy_title">Privasi Anda yang Utama</string>
    <string name="onboarding_privacy_desc">Kami memerlukan akses ke Kontak dan Riwayat Panggilan Anda untuk mencocokkan nomor masuk. <b>Semua data diproses 100% secara lokal di perangkat Anda.</b> Kami tidak pernah mengunggah data Anda ke server mana pun.</string>
    <string name="onboarding_btn_next">Selanjutnya</string>

